# Copy this file to .env and fill in values for local development.

# Postgres connection
POSTGRES_USER=cockpit
POSTGRES_PASSWORD=cockpit
POSTGRES_DB=cockpit
DATABASE_URL="postgresql://cockpit:cockpit@localhost:5433/cockpit"

# Redis connection
REDIS_URL="redis://localhost:6379"

# Jira configuration file path
JIRA_CONFIG_PATH="config/jira.yaml"

# Azure DevOps configuration
ADO_CONFIG_PATH="config/azure-devops.yaml"
USE_FAKE_AZURE_DEVOPS='true'

# API base URL accessible from the browser (used for image uploads)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Keycloak (V2 — IAM integration)
KEYCLOAK_ISSUER=http://localhost:8080/realms/vp-cockpit
KEYCLOAK_CLIENT_ID=vp-cockpit-web
KEYCLOAK_CLIENT_SECRET=vp-cockpit-secret
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/vp-cockpit/protocol/openid-connect/certs

# Public env vars (exposed to browser for login page)
NEXT_PUBLIC_KEYCLOAK_ISSUER=http://localhost:8080/realms/vp-cockpit
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=vp-cockpit-web

# NextAuth.js (V2)
NEXTAUTH_SECRET=change-me-in-production
NEXTAUTH_URL=http://localhost:3000

# Integration tests
DATABASE_TEST_URL=postgresql://cockpit:cockpit@localhost:5433/cockpit_test

# Microsoft Entra ID SSO (optional — leave blank to disable)
# Request these values from your Azure AD admin.
# See docs/superpowers/specs/2026-04-27-microsoft-sso-design.md for setup instructions.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Microsoft Graph directory sync (optional — leave blank to disable the Source tab)
# Needs an Entra app registration with the User.Read.All APPLICATION permission + admin consent.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Set USE_FAKE_GRAPH=true to run the worker without real Graph credentials.
USE_FAKE_GRAPH=

# ── Open-core edition switch (see planning/OPEN-CORE-ARCHITECTURE.md) ──
# 'community' (default; fully open, no enterprise features) or 'enterprise'.
DECKGAUGE_EDITION=community
# Absolute path to the built enterprise module entry (enterprise edition only).
#   dev (tsx):  <repo>/packages/enterprise/src/index.ts
#   prod (node): <repo>/packages/enterprise/dist/index.js
DECKGAUGE_ENTERPRISE_MODULE=
# Absolute path to the signed license file (enterprise edition only).
DECKGAUGE_LICENSE_FILE=
# DEV/TEST ONLY — trust an extra verify key from DECKGAUGE_LICENSE_PUBKEY so
# locally-generated licenses validate. NEVER set to 1 in production.
DECKGAUGE_ALLOW_DEV_LICENSE_KEYS=
DECKGAUGE_LICENSE_PUBKEY=
